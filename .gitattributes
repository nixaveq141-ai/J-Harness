* text=auto
.gitattributes text eol=lf
.mvn/**/*.properties text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
mvnw text eol=lf
mvnw.cmd text eol=crlf
web-ui.cmd -text
scripts/open-workbench.ps1 text eol=lf
*.py text eol=lf
*.yml text eol=lf
# Preserve original legal-resource bytes and their recorded hashes on every OS.
third-party/** -text
# CI evidence hashes refer to the original platform bytes, including JSON line endings.
docs/testing/M9-*.json -text
docs/testing/M10-*.json -text
docs/testing/M10.5.*.json -text
# Review manifests hash exact JSON bytes and must survive cross-platform checkout.
docs/development/ocr-verification-2026-10-20/*.json -text
docs/testing/OCR-verification-2026-10-20-results.json -text
docs/development/ocr-r0-rereview-2026-10-20/*.json -text
docs/testing/OCR-R0-rereview-2026-10-20-results.json -text
docs/development/OCR-remediation-progress.json text eol=lf
docs/development/OCR-implementation-artifacts.json text eol=lf
docs/testing/OCR-R0-rereview-fixes-2026-10-21-results.json -text
# Frontend source has stable LF bytes; copied upstream files retain their original bytes.
frontend/** text eol=lf
frontend/src/upstream/** -text
frontend/LICENSE-DeepSeek-Harness.txt -text
sdk/** text eol=lf
scripts/*.mjs text eol=lf
scripts/*.json text eol=lf
scripts/contracts/*.json text eol=lf
scripts/*.ps1 text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
